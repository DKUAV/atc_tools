# Use the exact tag listed in images.txt.
ATC_APP_IMAGE=
ATC_HOST_DATA_DIR=/srv/atc-tools
SSH_CONFIG_DIR=/srv/atc-ssh
ATC_API_BIND=127.0.0.1
ATC_API_PORT=8766
ATC_SSH_BIND=127.0.0.1
ATC_SSH_PORT=2222
ATC_BROWSER_SECURE_COOKIES=1
ATC_AMCT_TARGETS=310B4,910B2
# Set ATC_RUNTIME=ascend and the physical device ID to enable 910B2 verification.
ATC_RUNTIME=runc
ATC_910B2_DEVICE=
ATC_CPU_SLOTS=2
ATC_COMPILE_SLOTS=1
